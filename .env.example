# ============================================================
# DIGIX AI Chatbot — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git — it contains your API keys.
# See README_DELIVERY.md for full setup instructions.
# ============================================================


# ── OpenAI (required) ───────────────────────────────────────
# Used for: chat responses (GPT-4o) + speech transcription (Whisper API)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Model for chat responses.
# gpt-4o         — best quality, best Arabic support (recommended)
# gpt-4o-mini    — lower cost (~10× cheaper), slightly lower quality
# Change only if you want to reduce API costs.
OPENAI_MODEL=gpt-4o


# ── Azure Text-to-Speech (required for voice output) ────────
# Used for: converting chatbot text responses to spoken audio
# Get your key at: https://portal.azure.com → Cognitive Services → Speech
AZURE_TTS_KEY=your_azure_key_here

# The Azure region your Speech resource was created in.
# Must match exactly — wrong region causes authentication errors.
# Common options: eastus | westeurope | uaenorth | southeastasia
AZURE_TTS_REGION=eastus

# Arabic voice for the chatbot.
# ar-JO-SanaNeural    — Jordanian Arabic female (works on all Azure tiers) ← default
# ar-JO-ZariyahNeural — Jordanian Arabic female, more natural-sounding
#                       Requires: Azure subscription with access to all neural voices
#                       If you get "Unsupported voice" error, your subscription
#                       does not include this voice — use SanaNeural instead.
# ar-JO-TaimNeural    — Jordanian Arabic male, alternative option
# Full voice list: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
AZURE_VOICE_AR=ar-JO-SanaNeural

# English voice for the chatbot.
# en-US-JennyNeural — American English female (works on all Azure tiers)
# en-GB-SoniaNeural — British English female, alternative option
AZURE_VOICE_EN=en-US-JennyNeural


# ── Google Sheets (required for lead collection) ─────────────
# Used for: saving visitor contact details submitted through the chatbot
# Setup instructions: see README_DELIVERY.md → "First-time setup"
GOOGLE_SHEET_ID=your_sheet_id_here

# Absolute path to the service account JSON file downloaded from Google Cloud.
# Example (Linux/Mac): /home/user/digix-chatbot/service_account.json
# Example (Windows):   C:\Users\user\digix-chatbot\service_account.json
# In Docker:           /app/service_account.json  (already mapped, DO NOT CHANGE)
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json


# ── App settings ─────────────────────────────────────────────
# The public URL where the chatbot backend is running.
# Local development: http://localhost:8000
# Production:        https://your-domain.com  (no trailing slash)
BACKEND_URL=http://localhost:8000

# Comma-separated list of origins allowed to call the API.
# Must include the URL of the DIGIX AI website and any dev environments.
ALLOWED_ORIGINS=http://localhost:3000,https://digix-ai.com

# Log questions the chatbot could not answer to backend/logs/unanswered.log
# Useful for identifying knowledge gaps and improving the knowledge base.
# Set to false to disable.
LOG_UNANSWERED=true
